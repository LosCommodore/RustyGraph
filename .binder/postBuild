#!/bin/bash
# Runs once when Binder builds the image: installs Rust and the evcxr Jupyter kernel.
set -euo pipefail

EVCXR_VERSION=v0.22.0

# Rust toolchain (evcxr compiles every cell with cargo)
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
  | sh -s -- -y --profile minimal --component rust-src
source "$HOME/.cargo/env"

# Prebuilt kernel binary (compiling it here would add several minutes)
curl -sSfL "https://github.com/evcxr/evcxr/releases/download/$EVCXR_VERSION/evcxr_jupyter-$EVCXR_VERSION-x86_64-unknown-linux-gnu.tar.gz" \
  | tar xz --strip-components=1 -C "$HOME/.cargo/bin"
evcxr_jupyter --install

# Download petgraph now so the notebook's first cell only has to compile it
cargo fetch --manifest-path "${REPO_DIR:-$HOME}/Cargo.toml"
